extends layout

block content
  h1.h3 Link accounts
  if saved
    .alert.alert-success Saved.

  if staleLinks.length
    .alert.alert-warning
      h2.h6 No longer in Up
      p.mb-2
        | These links point to Up accounts that have been deleted, so they are skipped when syncing.
        | Unlink them, then close the Actual account in Actual if you no longer need it.
      p.mb-2
        | When Up deletes a saver it moves any leftover balance to another account as an ordinary deposit, and that
        | deposit gets imported. Before closing the Actual account, change that deposit's payee to a transfer from the
        | old account so its balance becomes $0. Don't let Actual transfer the balance again when closing, or it
        | will be counted twice.
      each s in staleLinks
        form.d-flex.align-items-center.gap-2.mb-1(method='POST' action='/link')
          input(type='hidden' name='account' value=s.upId)
          input(type='hidden' name='accID' value='')
          span Actual account: #[strong= s.actualName]
          button.btn.btn-sm.btn-outline-danger(type='submit') Unlink

  - const unlinked = upAccounts.filter((u) => !linkedAccounts[u.id])
  if unlinked.length
    .card.mb-4
      .card-body
        h2.h5.card-title Create Actual accounts from Up
        p.card-text.text-body-secondary
          | Creates a new Actual account for each selected Up account, imports every transaction from the start date,
          | and sets an opening balance so the Actual balance matches Up today.
        form(method='POST' action='/accounts/create')
          table.table.table-sm.align-middle.mb-2
            thead
              tr
                th Create
                th Up account
                th.text-center Off budget
            tbody
              each up in unlinked
                tr
                  td
                    input.form-check-input(type='checkbox' name='upAccountIds' value=up.id id='create-' + up.id checked)
                  td
                    label(for='create-' + up.id) #{up.displayName}
                      small.text-body-secondary  (#{up.accountType}#{up.ownershipType === 'JOINT' ? ', 2Up' : ''})
                  td.text-center
                    input.form-check-input(type='checkbox' name='offBudgetIds' value=up.id aria-label='Off budget: ' + up.displayName checked=up.accountType === 'HOME_LOAN')
          .row.g-2.align-items-end.mt-2
            .col-sm-4
              label.form-label(for='startDate') Import history from
              input#startDate.form-control(type='date' name='startDate' required value=defaultStartDate)
            .col-sm-4
              button.btn.btn-primary(type='submit') Create and link
          .form-text.mt-2
            | Off-budget accounts are tracked but not part of your budget, e.g. a child's pocket-money saver or a home loan.
            | Actual can't switch an account between on- and off-budget later, so choose here.

  h2.h5 Existing links
  form.mb-3(method='POST' action='/transfers/preview')
    button.btn.btn-sm.btn-outline-secondary(type='submit') Link existing transfers…
    span.form-text.ms-2 Turn transfers imported as two ordinary transactions into Actual transfers.
  p Choose which Actual account each Up account syncs into, or pick #[em ➕ Create new Actual account] to create one with its history from the 1st of this month (or since the Up account was opened, if later).
  each up in upAccounts
    form.row.g-2.align-items-center.mb-3(method='POST' action='/link')
      input(type='hidden' name='account' value=up.id)
      .col-sm-4
        label.col-form-label(for='acc-' + up.id) #{up.displayName}
          small.text-body-secondary  (#{up.accountType})
      .col-sm-6
        select.form-select(name='accID' id='acc-' + up.id)
          option(value='') Not linked
          option(value=createNew) ➕ Create new Actual account
          option(value=createNewOffBudget) ➕ Create new off-budget account
          each acc in actualAccounts
            option(value=acc.id selected=linkedAccounts[up.id] === acc.id)= acc.name
      .col-sm-2
        button.btn.btn-outline-primary.w-100(type='submit') Save
