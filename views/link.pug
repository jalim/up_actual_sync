extends layout

block content
  h1.h3 Link accounts
  if saved
    .alert.alert-success Saved.

  - const unlinked = upAccounts.filter((u) => !linkedAccounts[u.id])
  if unlinked.length
    .card.mb-4
      .card-body
        h2.h5.card-title Create Actual accounts from Up
        p.card-text.text-body-secondary
          | Creates a new Actual account for each selected Up account, imports every transaction from the start date,
          | and sets an opening balance so the Actual balance matches Up today.
        form(method='POST' action='/accounts/create')
          each up in unlinked
            .form-check
              input.form-check-input(type='checkbox' name='upAccountIds' value=up.id id='create-' + up.id checked)
              label.form-check-label(for='create-' + up.id) #{up.displayName}
                small.text-body-secondary  (#{up.accountType}#{up.ownershipType === 'JOINT' ? ', 2Up' : ''})
          .row.g-2.align-items-end.mt-2
            .col-sm-4
              label.form-label(for='startDate') Import history from
              input#startDate.form-control(type='date' name='startDate' required value=defaultStartDate)
            .col-sm-4
              button.btn.btn-primary(type='submit') Create and link
          .form-text.mt-2 Home loan accounts are created off-budget.

  h2.h5 Existing links
  p Choose which Actual account each Up account syncs into, or pick #[em ➕ Create new Actual account] to create one with its history from the 1st of this month (or since the Up account was opened, if later).
  each up in upAccounts
    form.row.g-2.align-items-center.mb-3(method='POST' action='/link')
      input(type='hidden' name='account' value=up.id)
      .col-sm-4
        label.col-form-label(for='acc-' + up.id) #{up.displayName}
          small.text-body-secondary  (#{up.accountType})
      .col-sm-6
        select.form-select(name='accID' id='acc-' + up.id)
          option(value='') Not linked
          option(value=createNew) ➕ Create new Actual account
          each acc in actualAccounts
            option(value=acc.id selected=linkedAccounts[up.id] === acc.id)= acc.name
      .col-sm-2
        button.btn.btn-outline-primary.w-100(type='submit') Save
