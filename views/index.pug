extends layout

block content
  p.lead Sync transactions from Up Bank into Actual Budget.
  p #{linkedCount} linked account#{linkedCount === 1 ? '' : 's'}.
  button#sync.btn.btn-primary(type='button') Sync now
  a.btn.btn-outline-primary.ms-2(href='/ofx') Import P&N OFX
  #status.mt-3(role='status' aria-live='polite')
    if lastSync
      if lastSync.ok
        .alert.alert-success
          | Last sync #{lastSync.at}:
          ul.mb-0
            each r in lastSync.results
              li #{r.name}: #{r.added} added, #{r.updated} updated#{r.transfers ? ', ' + r.transfers + ' transfers' : ''}#{r.errors.length ? ' (' + r.errors.join('; ') + ')' : ''}
      else
        .alert.alert-danger Last sync #{lastSync.at} failed: #{lastSync.error}

block scripts
  script(src='/client.js')
